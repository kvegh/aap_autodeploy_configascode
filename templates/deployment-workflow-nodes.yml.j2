---
- identifier: prepare_aap_resources
  unified_job_template:
    name: Deploy Test AAP - 01 AAP Resource Preconfigure
    type: job_template
    organization:
      name: {{ cac_workflow.organization | to_json }}
  related:
    success_nodes:
      - identifier: create_vm
    failure_nodes: []
    always_nodes: []

- identifier: create_vm
  job_tags: ''
  skip_tags: ''
  unified_job_template:
    name: Generic RHEL VM Deployment
    type: job_template
    organization:
      name: {{ cac_workflow.organization | to_json }}
  inventory:
    name: {{ cac_workflow.generic_vm.inventory | to_json }}
    organization:
      name: {{ cac_workflow.organization | to_json }}
  related:
    credentials:
{% for credential in cac_workflow.generic_vm.credentials %}
      - name: {{ credential | to_json }}
{% endfor %}
    success_nodes:
      - identifier: configure_infrastructure
    failure_nodes: []
    always_nodes: []

- identifier: configure_infrastructure
  unified_job_template:
    name: Deploy Test AAP - 02 Infra Config
    type: job_template
    organization:
      name: {{ cac_workflow.organization | to_json }}
  related:
    success_nodes:
      - identifier: install_aap
    failure_nodes: []
    always_nodes: []

- identifier: install_aap
  unified_job_template:
    name: Deploy Test AAP - 03 AAP Install
    type: job_template
    organization:
      name: {{ cac_workflow.organization | to_json }}
  related:
    success_nodes:
      - identifier: configure_base
    failure_nodes: []
    always_nodes: []

- identifier: configure_base
  unified_job_template:
    name: Deploy Test AAP - 04 AAP Config
    type: job_template
    organization:
      name: {{ cac_workflow.organization | to_json }}
  extra_data:
    aap_config_repo_url: {{ cac_workflow.repositories.base | to_json }}
  related:
    success_nodes: []
    failure_nodes: []
    always_nodes: []
