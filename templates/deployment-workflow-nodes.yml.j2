---
- identifier: create_vm
  unified_job_template:
    name: Deploy AAP on Rebuild Hypervisor - 01 VM Setup
    type: job_template
    organization:
      name: {{ cac_workflow.organization | to_json }}
  related:
    success_nodes:
      - identifier: configure_infrastructure
    failure_nodes: []
    always_nodes: []

- identifier: configure_infrastructure
  unified_job_template:
    name: Deploy AAP on Rebuild Hypervisor - 02 Infrastructure
    type: job_template
    organization:
      name: {{ cac_workflow.organization | to_json }}
  related:
    success_nodes:
      - identifier: install_aap
    failure_nodes: []
    always_nodes: []

- identifier: install_aap
  unified_job_template:
    name: Deploy AAP on Rebuild Hypervisor - 03 Install AAP
    type: job_template
    organization:
      name: {{ cac_workflow.organization | to_json }}
  related:
    success_nodes:
      - identifier: configure_base
    failure_nodes: []
    always_nodes: []

- identifier: configure_base
  unified_job_template:
    name: Deploy AAP on Rebuild Hypervisor - 04 Base Configuration
    type: job_template
    organization:
      name: {{ cac_workflow.organization | to_json }}
  related:
    success_nodes: []
    failure_nodes: []
    always_nodes: []
