---
# Empty shared configuration for infra.aap_configuration.dispatch.
# Copy to a separate working file; keep this example free of actual values.
# Base owns platform-wide setup only. Keep all use-case objects in project files.
# Encrypt populated sensitive configuration before adding it to Git.
# The file is plaintext despite its .example name; it contains no secrets.

# Optional desired administrator password. Store it only in the encrypted copy.
# Stage 04 uses the installer login for bootstrap when this password is not active.
# aap_password: ADMIN_PASSWORD_PLACEHOLDER
# aap_user_accounts_base:
#   - username: "{{ aap_username }}"
#     password: "{{ aap_password }}"
#     state: present
aap_organizations_base: []
aap_teams_base: []
# Empty by default; the encrypted example above may manage the administrator.
aap_user_accounts_base: []
# Platform content-source credentials may belong here; machine credentials do not.
controller_credentials_base: []
controller_settings_base: {}
# Containerized installations using remote Podman need the generated platform CA
# in project-update execution environments. Preserve existing isolation mounts
# and use the installer service account's HOST trust path for the additional mount.
# controller_settings_base:
#   settings:
#     AWX_ISOLATION_SHOW_PATHS:
#       - /etc/pki/ca-trust:/etc/pki/ca-trust:O
#       - /usr/share/pki:/usr/share/pki:O
#       - /INSTALLER_HOME/aap/tls/extracted:/etc/pki/ca-trust/extracted:ro
hub_collection_remotes_base: []
hub_collection_repositories_base: []
pah_base: {}

# Optional replacement-access bootstrap: when configured, include every pair.
# Each repository has its own Git read-token entry and CaC Vault entry.
# Replace placeholders only in the encrypted populated configuration.
# cac_bootstrap_git_credentials:
#   base:
#     aap_credential_name: aap_autodeploy_configascode-secrets CaC repo read token
#     token: BASE_REPOSITORY_READ_TOKEN_PLACEHOLDER
#   assistant_team:
#     aap_credential_name: assistant-team-secrets CaC repo read token
#     token: ASSISTANT_TEAM_REPOSITORY_READ_TOKEN_PLACEHOLDER
#   windows_disconnected:
#     aap_credential_name: disconnected-windows-patching-secrets CaC repo read token
#     token: WINDOWS_DISCONNECTED_REPOSITORY_READ_TOKEN_PLACEHOLDER
#   orchestrator:
#     aap_credential_name: automation-orchestrator-secrets CaC repo read token
#     token: ORCHESTRATOR_REPOSITORY_READ_TOKEN_PLACEHOLDER
#   aiops:
#     aap_credential_name: aiops-selfhealing-demo-secrets CaC repo read token
#     token: AIOPS_REPOSITORY_READ_TOKEN_PLACEHOLDER
# cac_bootstrap_vault_credentials:
#   base:
#     name: aap_autodeploy_configascode-secrets CaC vault cred
#     vault_id: cac
#     vault_password: BASE_CAC_VAULT_PASSWORD_PLACEHOLDER
#   assistant_team:
#     name: assistant-team-secrets CaC vault cred
#     vault_id: cac
#     vault_password: ASSISTANT_TEAM_CAC_VAULT_PASSWORD_PLACEHOLDER
#   windows_disconnected:
#     name: disconnected-windows-patching-secrets CaC vault cred
#     vault_id: cac
#     vault_password: WINDOWS_DISCONNECTED_CAC_VAULT_PASSWORD_PLACEHOLDER
#   orchestrator:
#     name: automation-orchestrator-secrets CaC vault cred
#     vault_id: cac
#     vault_password: ORCHESTRATOR_CAC_VAULT_PASSWORD_PLACEHOLDER
#   aiops:
#     name: aiops-selfhealing-demo-secrets CaC vault cred
#     vault_id: cac
#     vault_password: AIOPS_CAC_VAULT_PASSWORD_PLACEHOLDER

# Base sets selection/snapshot limits without synchronizing or deleting content.
# Release pruning separately preserves the newest installed release and audited
# project/playbook/execution-environment requirements plus dependency closure.
pah_collection_policy:
  mode: latest_installed_plus_requirements
  sync_highest_versions: 1
  retain_repo_versions: 1
  repositories:
    - rh-certified
    - validated
    - community
  require_complete_requirements_audit: true

# Base owns the PAH remotes, repositories, and distributions for rh-certified,
# validated, and community content, plus their Controller Galaxy credentials
# and organization attachments. Base configuration does not synchronize content.
# Set sync: false on every repository; Stage 04 must also exclude the dispatch
# role hub_collection_repository_sync so adding a repository never starts a sync.
# Keep upstream sync tokens separate from local PAH download credentials.
# URL-only setup omits auth_url. Hub requires token whenever auth_url is set;
# add both through encrypted configuration before future content synchronization.
# Complete pah_base before running Stage 04. Credential names and repository order
# must match the organization's galaxy_credentials list. The playbook creates
# read-scope tokens on the target; never copy a previous target's download token.
# pah_base:
#   organization: ORGANIZATION_PLACEHOLDER
#   download_credentials:
#     - name: PAH_CERTIFIED_CREDENTIAL_PLACEHOLDER
#       repository: rh-certified
#     - name: PAH_VALIDATED_CREDENTIAL_PLACEHOLDER
#       repository: validated
#     - name: PAH_COMMUNITY_CREDENTIAL_PLACEHOLDER
#       repository: community
# hub_collection_remotes_base:
#   - name: rh-certified
#     url: CERTIFIED_UPSTREAM_HTTPS_URL_PLACEHOLDER
#   - name: validated
#     url: VALIDATED_UPSTREAM_HTTPS_URL_PLACEHOLDER
#   - name: community
#     url: COMMUNITY_UPSTREAM_HTTPS_URL_PLACEHOLDER
# hub_collection_repositories_base:
#   - name: rh-certified
#     remote: rh-certified
#     distribution:
#       name: rh-certified
#       state: present
#     sync: false
#     update_repo: false
#     state: present
#   # Repeat for validated and community with matching remote/distribution names.

# Example list entries, using generic placeholders only:
# aap_organizations_base:
#   - name: ORGANIZATION_PLACEHOLDER
#     galaxy_credentials:
#       - PAH_CERTIFIED_CREDENTIAL_PLACEHOLDER
#       - PAH_VALIDATED_CREDENTIAL_PLACEHOLDER
#       - PAH_COMMUNITY_CREDENTIAL_PLACEHOLDER
# PAH credentials above are managed separately; omit them from
# controller_credentials_base. Other platform credentials can use that list.
